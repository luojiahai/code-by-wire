---
// website/src/layouts/DocsLayout.astro
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocsToc from '../components/DocsToc.astro';
import DocsPager from '../components/DocsPager.astro';
import { getPrevNext, sortDocsNav } from '../lib/docs-nav';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  currentId: string;
  headings: Heading[];
}

const { title, description, currentId, headings } = Astro.props;

const docs = sortDocsNav(await getCollection('docs'));
const { prev, next } = getPrevNext(docs, currentId);
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const base = import.meta.env.BASE_URL;
const canonical = new URL(`${base}docs/${currentId}/`, Astro.site).href;
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <div class:list={['docs-shell', { 'no-toc': tocItems.length === 0 }]}>
    <DocsSidebar docs={docs} currentId={currentId} />
    <main id="main-content" class="docs-content">
      <slot />
      <DocsPager prev={prev} next={next} />
    </main>
    {tocItems.length > 0 && <DocsToc items={tocItems} />}
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 200px;
    grid-template-areas: 'sidebar content toc';
    gap: 64px;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 80px 48px 128px;
    align-items: start;
  }
  .docs-shell.no-toc {
    grid-template-columns: 240px minmax(0, 1fr);
    grid-template-areas: 'sidebar content';
  }
  .docs-content {
    grid-area: content;
    min-width: 0;
    max-width: 760px;
  }
  @media (max-width: 1024px) {
    .docs-shell,
    .docs-shell.no-toc {
      grid-template-columns: 220px minmax(0, 1fr);
      grid-template-areas: 'sidebar content';
    }
  }
  @media (max-width: 768px) {
    .docs-shell,
    .docs-shell.no-toc {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'sidebar' 'content';
      padding: 40px 20px 96px;
      gap: 0;
    }
  }
  @media (max-width: 640px) {
    .docs-shell,
    .docs-shell.no-toc {
      padding: 28px 20px 88px;
    }
  }
</style>
