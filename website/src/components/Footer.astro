---
// website/src/components/Footer.astro
const base = import.meta.env.BASE_URL;
---
<div class="footer-bar">
  <footer>
    <div class="footer-intro">
      <a href={base} class="brand">
        <img src={`${base}mark.svg`} alt="" class="brand-mark" width="35" height="20" />
        <span class="brand-name">Code-by-wire</span>
      </a>
      <p>The control surface for coding agents running on your machine.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={`${base}download/`}>Download</a>
      <a href={`${base}docs/`}>Docs</a>
      <a href={`${base}changelog/`}>Changelog</a>
      <a href="https://github.com/luojiahai/code-by-wire">GitHub</a>
      <a href={`${base}sponsor/`}>Sponsor</a>
    </nav>
    <div class="footer-meta">
      <span>© 2026 luojiahai</span>
      <a href="https://github.com/luojiahai/code-by-wire/blob/main/LICENSE">MIT licensed</a>
    </div>
  </footer>
</div>

<style>
  .footer-bar {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
  }
  footer {
    padding: 64px 48px 32px;
    max-width: var(--page-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(240px, 1.4fr) 1fr;
    gap: 64px 80px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand-mark {
    display: block;
  }
  .brand-name {
    font-weight: 620;
    font-size: 15px;
    letter-spacing: -0.025em;
  }
  .footer-intro p {
    max-width: 34ch;
    margin-top: 18px;
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .footer-links {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-links a {
    color: var(--text-dim);
    font-size: 13px;
    transition: color 180ms ease;
  }
  .footer-links a:hover {
    color: var(--text);
  }
  .footer-meta {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 11px;
    font-family: 'JetBrains Mono Variable', monospace;
    letter-spacing: 0.04em;
  }
  .footer-meta a {
    transition: color 180ms ease;
  }
  .footer-meta a:hover {
    color: var(--text);
  }
  @media (max-width: 640px) {
    footer {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 48px 20px 28px;
    }
    .footer-links {
      justify-content: flex-start;
      gap: 14px 22px;
    }
    .footer-meta {
      grid-column: auto;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
