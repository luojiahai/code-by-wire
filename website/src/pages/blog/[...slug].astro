---
// website/src/pages/blog/[...slug].astro
import { getCollection, render } from 'astro:content';
import NarrowLayout from '../../layouts/NarrowLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<NarrowLayout title={`${post.data.title} · Code-by-wire blog`} description={post.data.description}>
  <p class="eyebrow">Field note</p>
  <h1 class="page-title">{post.data.title}</h1>
  <time class="mono post-date">{post.data.publishDate}</time>
  <div class="prose">
    <Content />
  </div>
</NarrowLayout>

<style>
  .page-title {
    max-width: 18ch;
    margin-bottom: 18px;
    font-size: clamp(2.75rem, 7vw, 4.75rem);
  }
  .post-date {
    color: var(--text-faint);
    font-size: 13px;
    display: block;
    margin-bottom: 56px;
  }
</style>
