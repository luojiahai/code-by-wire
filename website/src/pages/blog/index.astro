---
// website/src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import NarrowLayout from '../../layouts/NarrowLayout.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
);
---
<NarrowLayout title="Blog · Code-by-wire" description="News and updates from Code-by-wire.">
  <p class="eyebrow">Field notes</p>
  <h1 class="page-title">From the wire.</h1>
  <ul>
    {
      posts.map((post, index) => (
        <li>
          <span class="post-number mono">{String(index + 1).padStart(2, '0')}</span>
          <div class="post-copy">
            <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
            <p>{post.data.description}</p>
            <time class="mono">{post.data.publishDate}</time>
          </div>
          <span class="post-arrow" aria-hidden="true">↗</span>
        </li>
      ))
    }
  </ul>
</NarrowLayout>

<style>
  .page-title {
    margin-bottom: 64px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: 18px;
    border-top: 1px solid var(--border);
    padding: 28px 0;
  }
  li:last-child {
    border-bottom: 1px solid var(--border);
  }
  a {
    font-size: 21px;
    font-weight: 590;
    letter-spacing: -0.025em;
    transition: color 180ms ease;
  }
  a:hover {
    color: var(--accent-bright);
  }
  p {
    color: var(--text-dim);
    font-size: 14px;
    margin-top: 6px;
  }
  time {
    color: var(--text-faint);
    font-size: 12px;
    display: block;
    margin-top: 10px;
  }
  .post-number,
  .post-arrow {
    color: var(--text-faint);
    font-size: 10px;
  }
  .post-number {
    padding-top: 8px;
  }
  .post-arrow {
    padding-top: 5px;
    font-size: 15px;
  }
  @media (max-width: 640px) {
    .page-title {
      margin-bottom: 48px;
    }
    li {
      grid-template-columns: 28px 1fr;
      gap: 12px;
    }
    .post-arrow {
      display: none;
    }
  }
</style>
