---
// website/src/pages/docs/[...slug].astro
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { sortDocsNav } from '../../lib/docs-nav';

export async function getStaticPaths() {
  const pages = await getCollection('docs');
  const firstPage = sortDocsNav(pages)[0];

  return [
    ...pages.map((page) => ({
      params: { slug: page.id as string | undefined },
      props: { page },
    })),
    { params: { slug: undefined }, props: { page: firstPage } },
  ];
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
---
<DocsLayout
  title={`${page.data.title} · Code-by-wire docs`}
  description={page.data.description}
  currentId={page.id}
  headings={headings}
>
  <p class="eyebrow">Operator manual</p>
  <h1 class="page-title">{page.data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</DocsLayout>

<style>
  .page-title {
    max-width: 18ch;
    margin-bottom: 48px;
    font-size: clamp(2.75rem, 7vw, 4.5rem);
  }
</style>
