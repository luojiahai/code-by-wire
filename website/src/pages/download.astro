---
// website/src/pages/download.astro
import NarrowLayout from '../layouts/NarrowLayout.astro';

const APPLE_PATH =
  'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zm3.415-3.132c.845-1.026 1.4-2.454 1.245-3.882-1.207.052-2.662.805-3.532 1.831-.78.907-1.454 2.36-1.273 3.75 1.375.104 2.715-.688 3.56-1.7z';
const WINDOWS_PATH =
  'M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.851';

const releaseBase = 'https://github.com/luojiahai/code-by-wire/releases/latest/download';
const groups = [
  {
    id: 'macos',
    label: 'macOS',
    iconPath: APPLE_PATH,
    platforms: [
      { name: 'Apple Silicon', file: 'Code-by-wire-arm64.dmg' },
      { name: 'Intel', file: 'Code-by-wire-x64.dmg' },
    ],
  },
  {
    id: 'windows',
    label: 'Windows',
    iconPath: WINDOWS_PATH,
    platforms: [
      { name: 'x64', file: 'Code-by-wire-Setup-x64.exe' },
      { name: 'ARM64', file: 'Code-by-wire-Setup-arm64.exe' },
    ],
  },
];
---
<NarrowLayout
  title="Download · Code-by-wire"
  description="Download Code-by-wire for macOS or Windows."
>
  <p class="eyebrow">Desktop builds</p>
  <h1 class="page-title">Take the controls.</h1>
  <p class="page-lead">
    One click starts the download. Always the latest release. You'll need{' '}
    <a href="https://docs.anthropic.com/en/docs/claude-code">Claude Code</a> and/or{' '}
    <a href="https://developers.openai.com/codex/cli">Codex</a> installed locally, so there are
    sessions to observe and control.
  </p>

  <div class="platforms">
    {
      groups.map((group) => (
        <section id={group.id} class="platform-group">
          <div class="platform-heading">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={group.iconPath} />
            </svg>
            <h2>{group.label}</h2>
          </div>
          <div class="download-buttons">
            {group.platforms.map((p) => (
              <a href={`${releaseBase}/${p.file}`} class="download-btn">
                <span class="download-btn-text">
                  <strong>{p.name}</strong>
                  <span class="file-name">{p.file}</span>
                </span>
                <svg class="download-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 2v9m0 0 3.5-3.5M8 11 4.5 7.5M3 14h10" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</NarrowLayout>

<style>
  .page-lead {
    margin-bottom: 64px;
  }
  .page-lead a {
    color: var(--text);
    text-decoration: underline var(--border-strong);
    text-underline-offset: 4px;
  }
  .platforms {
    display: grid;
    gap: 18px;
  }
  .platform-group {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 32px;
    padding: 24px 0;
    border-top: 1px solid var(--border);
  }
  .platform-heading {
    display: flex;
    align-items: center;
    align-self: start;
    gap: 12px;
    padding-top: 16px;
    color: var(--text-dim);
  }
  .platform-heading h2 {
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
  }
  .download-buttons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--border);
  }
  .download-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-width: 0;
    padding: 18px;
    background: var(--bg-soft);
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }
  .download-btn:hover {
    color: var(--accent-bright);
    background: var(--bg-raised);
  }
  .download-btn-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
  }
  .download-btn-text strong {
    font-size: 15px;
    font-weight: 600;
  }
  .download-btn-text .file-name {
    font-family: 'JetBrains Mono Variable', monospace;
    overflow: hidden;
    color: var(--text-faint);
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .download-arrow {
    flex: none;
    color: var(--text-faint);
    transition: transform 200ms ease;
  }
  .download-btn:hover .download-arrow {
    transform: translateY(2px);
  }
  @media (max-width: 700px) {
    .page-lead {
      margin-bottom: 48px;
    }
    .platform-group {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .platform-heading {
      padding-top: 0;
    }
    .download-buttons {
      grid-template-columns: 1fr;
    }
  }
</style>
